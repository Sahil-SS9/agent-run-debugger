{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hermes-run-debugger/trace-v1",
  "title": "Agent Run Debugger Trace v1",
  "description": "Normalisation contract for one imported agent run. Strict: an unknown schema id, version, record kind, event kind, provenance value or field is refused rather than repaired. Outcome is separate from correctness: 'completed' never means 'task passed'. Unknown values are null/unknown, never 0.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/record" },
  "$defs": {
    "record": {
      "oneOf": [
        { "$ref": "#/$defs/trace" },
        { "$ref": "#/$defs/attempt" },
        { "$ref": "#/$defs/event" }
      ]
    },
    "provenance": { "enum": ["observed", "reported", "inferred", "unknown"] },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "version", "trace_id", "run_id", "source", "redaction", "completeness"],
      "properties": {
        "kind": { "const": "trace" },
        "schema": { "const": "hermes-run-debugger/trace" },
        "version": { "const": 1 },
        "trace_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "importer": { "type": "string" },
        "importer_version": { "type": "string" },
        "source_format": { "type": "string" },
        "source_scope": { "type": "string", "description": "always 'explicit-selection' in v1: the operator selects the source" },
        "created_at": { "$ref": "#/$defs/wall" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["file", "export", "hook", "session", "unknown"] },
            "ref": { "type": "string", "description": "PRIVATE content digest; omitted from exports" },
            "name": { "type": "string" }
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": { "type": "string" },
            "applied_count": { "type": "integer", "minimum": 0 },
            "categories": { "type": "object" },
            "limitations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "covered_kinds": { "type": "array", "items": { "$ref": "#/$defs/event_kind" } },
        "unsupported_kinds": { "type": "array", "items": { "$ref": "#/$defs/event_kind" } },
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["complete", "partial", "unknown"] },
            "missing_kinds": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "array", "items": { "type": "string" } },
            "source_limits": { "type": "object" },
            "truncation": { "type": ["string", "null"] },
            "capture_windows": { "type": "array", "items": { "type": "object" } }
          },
          "description": "A skipped-callback count is deliberately NOT a field: if the host did not expose it, the importer must not invent an exact number."
        },
        "private_digests": { "type": "object", "description": "PRIVATE: never exported" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "attempt_id", "run_id", "outcome"],
      "properties": {
        "kind": { "const": "attempt" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "parent_attempt_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "model": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "sequence": { "type": "integer", "minimum": 0 },
        "started_at": { "$ref": "#/$defs/wallnullable" },
        "ended_at": { "$ref": "#/$defs/wallnullable" },
        "outcome": { "enum": ["completed", "failed", "interrupted", "unknown"] },
        "unknowns": { "type": "array", "items": { "type": "string" }, "description": "what the source did not report (e.g. 'outcome', 'model')" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "event_id", "run_id", "attempt_id", "source_sequence", "event_kind", "semantic_provenance"],
      "properties": {
        "kind": { "const": "event" },
        "event_id": { "$ref": "#/$defs/id" },
        "run_id": { "$ref": "#/$defs/id" },
        "attempt_id": { "$ref": "#/$defs/id" },
        "span_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }], "description": "opaque source span/tool_use id; not a reconstructed span" },
        "causal_parents": { "type": "array", "items": { "$ref": "#/$defs/id" }, "description": "known parents only; an absent parent becomes a visible gap, never an inferred edge" },
        "source_sequence": { "type": "integer", "minimum": 0 },
        "wall_time": { "$ref": "#/$defs/wallnullable" },
        "monotonic_ms": { "type": ["integer", "null"] },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": { "enum": ["wall", "monotonic", "mixed", "unknown"] },
            "quality": { "enum": ["high", "medium", "low", "unknown"] },
            "drift_ms": { "type": ["integer", "null"] }
          }
        },
        "event_kind": { "$ref": "#/$defs/event_kind" },
        "reported_status": { "enum": ["ok", "failed", "interrupted", "skipped", "unknown"] },
        "reported_error": { "type": ["string", "null"], "maxLength": 4096 },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "cache_read_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "cache_write_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "cost": { "type": ["number", "null"], "description": "reported or estimated spend, verbatim; null when unknown — never 0" },
            "cost_kind": { "enum": ["actual", "estimated", "unknown"] },
            "price_source": { "type": ["string", "null"], "description": "required whenever cost_kind is 'estimated'" },
            "price_version": { "type": ["string", "null"] }
          }
        },
        "evidence_ref": { "type": ["string", "null"], "description": "opaque reference into the source; not a receipt and not verified" },
        "delivered_via": { "enum": ["import", "hook", "live_read", "export", "unknown"] },
        "semantic_provenance": { "$ref": "#/$defs/provenance" },
        "gaps": { "type": "array", "items": { "type": "string" } },
        "contradictions": { "type": "array", "items": { "type": "string" } },
        "name": { "type": ["string", "null"], "maxLength": 128, "description": "reported subject (tool/model name); control-character free" },
        "arguments_ref": { "type": ["string", "null"], "description": "opaque reference to tool arguments; the arguments themselves are never persisted by default" }
      }
    },
    "event_kind": {
      "enum": ["model_call", "tool_call", "subagent_handoff", "retry", "approval_request", "approval_response", "interrupt", "session_lifecycle", "provider_error", "note"]
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+~^=-]{0,127}$" },
    "wall": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$" },
    "wallnullable": { "type": ["string", "null"] }
  }
}
